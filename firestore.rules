rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.active == true;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /countries/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /card_designs/{designId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /card_language_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Authorization is stored separately from writable user profiles.
    // A user can only inspect their own role; only an already active
    // administrator can grant, revoke, or remove administrative access.
    match /admin_roles/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public feature switches control storefront availability. Only an
    // administrator may change them; no payment or courier secret is stored
    // in Firestore.
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow create, update: if ownsUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow create, update: if ownsUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.user_id == request.auth.uid
      );
      allow create: if isAdmin() || (
        signedIn() && request.resource.data.user_id == request.auth.uid
      ) || (
        !signedIn() && request.resource.data.guest_email is string
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /recipient_registrations/{registrationId} {
      // The sender may review the registration of a postcard that belongs to
      // their paid order. Other travelers must never be able to read the
      // recipient's details.
      allow read: if isAdmin() || (
        signedIn() && resource.data.traveler_user_id == request.auth.uid
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /inventory_units/{unitId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.traveler_user_id == request.auth.uid
      );
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn() && resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
      );
      allow create, delete: if isAdmin();
    }

    // POD manifests are immutable server artifacts. Administrators may inspect
    // them, but even an admin client cannot create, update, or delete them.
    match /pod_print_manifests/{manifestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_print_manifest_chunks/{chunkId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Canonical PDFs are created by the trusted backend. Client SDKs may only
    // inspect artifact metadata as an active administrator.
    match /pod_print_artifacts/{artifactId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_print_asset_sets/{assetSetId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_print_asset_set_chunks/{chunkId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_print_asset_set_items/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_production_batches/{batchId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_production_batch_chunks/{chunkId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_production_batch_memberships/{membershipId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pod_production_batch_artifacts/{artifactId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /shipments/{shipmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{collection}/{documentId} {
      allow read, write: if isAdmin()
        && collection in [
          'stock_batches',
          'stock_production_orders',
          'inventory_locations',
          'inventory_movements',
          'inventory_unit_events',
          'shipments',
          'qr_print_jobs',
          'qr_print_job_items',
          'pod_production_batch_orders',
          'config',
          'platform_stats',
          'gamification_config',
          'gamification_tiers'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
