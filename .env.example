HOTPAY_SECRET=
# Backend sales opt-in. Keep false on PROD until launch; set true on UAT.
SALES_ENABLED=false
# Canonical HTTPS return origin; never supplied by the customer request.
CHECKOUT_RETURN_ORIGIN=
HOTPAY_NOTIFICATION_PASSWORD=
# Secret used only by Vercel Cron to finalize account deletions after the
# 30-day cancellation window. Set it as an encrypted Vercel environment value.
CRON_SECRET=
# Used only by the local Express bridge. Keep payment creation on the UAT
# backend so the Firestore order is persisted before HotPay redirects back.
PAYMENT_BACKEND_API_URL=https://podrozowka-uat-one.vercel.app
# Used locally by the recipient QR test. Replace with your workstation IPv4
# address when testing from a phone connected to the same Wi-Fi network.
REGISTRATION_BACKEND_API_URL=https://podrozowka-uat-one.vercel.app
# Required by the Vercel POD manifest service. Use the public Firebase Hosting
# origin whose /r/:token route is encoded into printed QR codes. PUBLIC_APP_URL
# is preferred; FRONTEND_ORIGIN is also used for API CORS.
PUBLIC_APP_URL=
FRONTEND_ORIGIN=
# Private GCS bucket used by the trusted backend for immutable canonical POD PDFs.
POD_PRINT_ARTIFACT_BUCKET=
# Optional catalog image bucket for admin uploads. When empty, the backend
# derives the Firebase Storage bucket from the configured Firebase project.
POD_CARD_ASSET_BUCKET=
# Extra exact browser origins permitted for authenticated PDF upload sessions.
# For local UAT testing: http://127.0.0.1:3000
POD_PRINT_ALLOWED_ORIGINS=
# Comma-separated HTTPS image hosts accepted by the POD asset freezer.
# The HTTPS host configured in FRONTEND_ORIGIN/PUBLIC_APP_URL is included
# automatically for root-relative card-design assets. flagcdn.com is needed
# when country_flag_url is absent.
POD_PRINT_ASSET_ALLOWED_HOSTS=flagcdn.com
# Exact host of the versioned Fontsource CDN files recorded in the generated
# registry. Every WOFF2 is additionally pinned by a committed SHA-256.
POD_PRINT_FONT_ALLOWED_HOSTS=cdn.jsdelivr.net
# Exact, reviewed template hashes make changed artwork fail closed. Font hashes
# live in src/lib/podFontRegistry.generated.ts and require a new render profile.
POD_PRINT_TEMPLATE_FRONT_SHA256=
POD_PRINT_TEMPLATE_BACK_SHA256=
VITE_TEST_QR_BASE_URL=http://192.168.1.46:4173
INPOST_SHIPX_ENV=
INPOST_SHIPX_ORGANIZATION_ID=
INPOST_SHIPX_TOKEN=
INPOST_GEOWIDGET_TOKEN=
ORLEN_WIDGET_TOKEN=
ORLEN_WIDGET_MAP_URL=https://api.orlenpaczka.pl/
# Direct ORLEN Paczka SOAP API. Keep PartnerKey only in server/Vercel secrets;
# it must never be stored in Firestore or exposed with a VITE_ prefix.
ORLEN_PACZKA_ENV=sandbox
ORLEN_PACZKA_PARTNER_ID=
ORLEN_PACZKA_PARTNER_KEY=
# Optional separate private bucket for labels. Defaults to POD_PRINT_ARTIFACT_BUCKET.
ORLEN_PACZKA_LABEL_BUCKET=
# Sender data may be held as admin-only config/orlen_paczka fields, or supplied
# here to keep all operational data in deployment configuration.
ORLEN_PACZKA_SENDER_NAME=
ORLEN_PACZKA_SENDER_STREET=
ORLEN_PACZKA_SENDER_POSTAL_CODE=
ORLEN_PACZKA_SENDER_CITY=
ORLEN_PACZKA_SENDER_PHONE=
ORLEN_PACZKA_SENDER_EMAIL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_TEST_DATA_CLEANUP=false
VITE_CATALOG_SOURCE=firestore
VITE_BACKEND_API_URL=https://podrozowka-uat-one.vercel.app
VITE_INPOST_GEOWIDGET_TOKEN=
VITE_PUBLIC_APP_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
