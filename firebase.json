{
  "firestore": {
    "database": "ai-studio-podrozowkauat-e1d9b39b-c759-477c-98ea-34396a1afd2f",
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "podrozowka",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "podrozowka-uat",
          "region": "us-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
